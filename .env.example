# Use the same strong random value for both middleware and agent authentication.
# Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# The same shared key protects both protocol surfaces: the REST endpoints
# and the MCP server. CARRIER_API_KEY doubles as the MCP credential — there
# are no new environment variables for MCP — and the MCP endpoint is
# CARRIER_API_BASE + /mcp (see CARRIER_API_BASE below).
MIDDLEWARE_API_KEY=replace-with-a-unique-random-secret
CARRIER_API_KEY=replace-with-the-same-secret

# Optional live integrations
FMCSA_API_KEY=
TMS_HOST=localhost
TMS_PORT=17159
TMS_AUTH=
TMS_TIMEOUT=10

# Local agent settings
# CARRIER_API_BASE is the middleware's base URL; the agent's MCP endpoint
# is CARRIER_API_BASE + /mcp (streamable HTTP), authenticated with
# CARRIER_API_KEY (sent as the x-api-key header).
CARRIER_API_BASE=http://127.0.0.1:8000
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
EXTRACT_MODEL=gpt-4o-mini
CALL_LOG_DB=agent/call_log.db

# Keep both disabled outside local development.
ENABLE_TEST_CARRIERS=false
ENABLE_TEST_LOADS=false
ENABLE_TMS_RAW=false
